                         LARGE_INTEGER due; due.QuadPart = -(wait_us * 10);
                         SetWaitableTimer(t_tm2, &due, 0, NULL, NULL, FALSE);
                         HANDLE hs[2] = { s_kick_ev[kick_slot], t_tm2 };
@@ -4246,7 +4249,8 @@ static DWORD WINAPI spurs_kernel_thread(LPVOID p)
 #ifdef _WIN32
                     static SPU_PM_TLS HANDLE t_tm = NULL; static SPU_PM_TLS int t_tm_tried = 0;
                     if (!t_tm_tried) { t_tm_tried = 1; t_tm = CreateWaitableTimerExW(NULL, NULL, 0x00000002, 0x1F0003); }
-                    if (t_tm && wait_us > 0) { LARGE_INTEGER due; due.QuadPart = -(wait_us * 10); SetWaitableTimer(t_tm, &due, 0, NULL, NULL, FALSE); WaitForSingleObject(t_tm, INFINITE); }
+                    if (wait_us > 0 && host_wait_nt()) host_sleep_us(wait_us);
+                    else if (t_tm && wait_us > 0) { LARGE_INTEGER due; due.QuadPart = -(wait_us * 10); SetWaitableTimer(t_tm, &due, 0, NULL, NULL, FALSE); WaitForSingleObject(t_tm, INFINITE); }
                     else if (wait_us > 0) Sleep(1); else SwitchToThread();
 #else
                     if (wait_us > 0) usleep((useconds_t)wait_us); else sched_yield();
diff --git a/ps3recomp/runtime/ppu/ppu_sysprx.cpp b/ps3recomp/runtime/ppu/ppu_sysprx.cpp
index faf9184..08a9c5e 100644
--- a/ps3recomp/runtime/ppu/ppu_sysprx.cpp
+++ b/ps3recomp/runtime/ppu/ppu_sysprx.cpp
@@ -541,6 +541,26 @@ long long lwc_poll_us()
  * the 1 ms cap each one woke ~1000x/s and ran an empty work pass (~145k waits / 10 s in play155,
  * [LWCOND-STAT]), every pass several HLE calls (lwmutex lock/unlock, the shared ppu_gcm_pump atomics).
  * FIOS (lr 0x442B80) is NOT in the default list: it relies on the 1 ms poll. */
+/* Timed condition-variable wait for the lwcond paths below. libc++ on Windows hands
+ * SleepConditionVariableSRW the remaining time truncated to whole milliseconds, so a 1 ms
+ * wait_for starts with a 0 ms wait and then spins on SleepConditionVariableSRW(0) until the
+ * deadline: every FIOS thread in its 1 ms poll burned 25-55 % of a CPU (seen under Proton on an
+ * 8-core ARM64 handheld). With libc++, waits of 1 ms or more become one OS wait of the time
+ * rounded up to whole ms; the caller treats an early or late wake like a poll wake. Shorter
+ * waits and every other standard library keep std::condition_variable::wait_for. */
+template <class Pred>
+static bool lwc_cv_wait_us(std::condition_variable& cv, std::unique_lock<std::mutex>& lk, long long us, Pred pred)
+{
+#if defined(_WIN32) && defined(_LIBCPP_VERSION)
+    if (us >= 1000) {
+        if (pred()) return true;
+        const long long ms = (us + 999) / 1000;
+        cv.wait_for(lk, std::chrono::microseconds(ms * 1000 + 900));   /* truncates to exactly ms */
+        return pred();
+    }
+#endif
+    return cv.wait_for(lk, std::chrono::microseconds(us), pred);
+}
 struct LwcSitePoll { int n = 0; uint32_t lr[8] = {0}; long long us[8] = {0}; };
 const LwcSitePoll& lwc_site_poll_cfg()
 {
@@ -738,8 +758,7 @@ static void sys_lwcond_wait(ppu_context* ctx)
             long long cap_us = use_obj ? lwc_site_poll_us((uint32_t)ctx->lr, lwc_poll_us()) : 1000;   /* v156 per-site cap */
             const bool guest_cap = timeout_us && (long long)timeout_us < cap_us;
             if (guest_cap) cap_us = (long long)timeout_us;
-            bool got = CV.wait_for(lk, std::chrono::microseconds(cap_us),
-                                   [&]{ return MAP[lwcond].pending > 0; });
+            bool got = lwc_cv_wait_us(CV, lk, cap_us, [&]{ return MAP[lwcond].pending > 0; });
             LwcState& st = MAP[lwcond];
             if (got) st.pending--;
             st.waiters--;
@@ -763,7 +782,7 @@ static void sys_lwcond_wait(ppu_context* ctx)
             auto pred = [&]{ return MAP[lwcond].pending > 0; };
             bool got;
             if (!guest_tmo && max_ms <= 0) { CV.wait(lk, pred); got = true; }
-            else got = CV.wait_for(lk, std::chrono::milliseconds(lim_ms), pred);
+            else got = lwc_cv_wait_us(CV, lk, lim_ms * 1000, pred);
             LwcState& st = MAP[lwcond];
             if (got) st.pending--;
             st.waiters--;
