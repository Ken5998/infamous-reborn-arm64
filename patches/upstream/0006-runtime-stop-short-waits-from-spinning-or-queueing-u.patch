From 511738481ccbe05fa038e7a706660c71f26f15cf Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Kenan=20Kasumovi=C4=87?=
 <46025606+Ken5998@users.noreply.github.com>
Date: Sun, 15 Nov 2026 17:09:26 +0000
Subject: [PATCH 6/6] runtime: stop short waits from spinning or queueing under
 Proton

libc++ on Windows truncates a condition variable's remaining time to
whole milliseconds, so the 1 ms lwcond poll (FIOS' scheduler and media
threads) started with a 0 ms wait and spun until the deadline: ten such
threads took 25-55% of a CPU each on an 8-core handheld. Waits of 1 ms
or more now make one OS wait of the time rounded up to whole ms.

Under Wine, waitable timers are wineserver objects, and the SPURS
kernels park on a 250 us timer thousands of times a second. Take
NtDelayExecution and NtWaitForSingleObject with a relative timeout
there instead (PORT_WINE_TIMERS=1 keeps the timers); native Windows is
unchanged.
---
 ps3recomp/include/ps3emu/host_wait.h   | 59 ++++++++++++++++++++++++++
 ps3recomp/libs/spurs/cellSpurs.c       |  8 +++-
 ps3recomp/runtime/ppu/ppu_sysprx.cpp   | 25 +++++++++--
 ps3recomp/runtime/syscalls/sys_timer.c |  5 ++-
 4 files changed, 91 insertions(+), 6 deletions(-)
 create mode 100644 ps3recomp/include/ps3emu/host_wait.h

diff --git a/ps3recomp/include/ps3emu/host_wait.h b/ps3recomp/include/ps3emu/host_wait.h
new file mode 100644
index 0000000..c396a10
--- /dev/null
+++ b/ps3recomp/include/ps3emu/host_wait.h
@@ -0,0 +1,59 @@
+/* Short timed waits that stay inside the process under Wine/Proton.
+ *
+ * Waitable timers are wineserver objects: every SetWaitableTimer and every wait on one is a
+ * request to the single wineserver thread. The SPURS kernels park on a 250 us timer thousands
+ * of times a second each, so on a machine with few cores the wineserver falls behind and the
+ * parked kernels wake (and find their work) late. Under Wine the same waits go through
+ * NtDelayExecution (non-alertable: a nanosleep in the process) and NtWaitForSingleObject with a
+ * relative 100 ns timeout (fsync/esync wait on the event in the process). Native Windows keeps
+ * the high-resolution timers. PORT_WINE_TIMERS=1 restores the timer path under Wine as well. */
+#ifndef PS3EMU_HOST_WAIT_H
+#define PS3EMU_HOST_WAIT_H
+#ifdef _WIN32
+#include <windows.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+typedef LONG (NTAPI* host_wait_delay_fn)(BOOLEAN, PLARGE_INTEGER);
+typedef LONG (NTAPI* host_wait_single_fn)(HANDLE, BOOLEAN, PLARGE_INTEGER);
+
+static host_wait_delay_fn  s_host_wait_delay;
+static host_wait_single_fn s_host_wait_single;
+
+/* 1 = take the in-process path (running under Wine and not overridden) */
+static inline int host_wait_nt(void)
+{
+    static volatile int v = -1;
+    if (__builtin_expect(v < 0, 0)) {
+        HMODULE nt = GetModuleHandleA("ntdll.dll");
+        const int wine = nt && GetProcAddress(nt, "wine_get_version");
+        const char* e = getenv("PORT_WINE_TIMERS");
+        int on = wine && !(e && *e == '1');
+        if (on) {
+            s_host_wait_delay  = (host_wait_delay_fn)(void*)GetProcAddress(nt, "NtDelayExecution");
+            s_host_wait_single = (host_wait_single_fn)(void*)GetProcAddress(nt, "NtWaitForSingleObject");
+            on = s_host_wait_delay && s_host_wait_single;
+        }
+        static volatile LONG s_said = 0;
+        if (wine && InterlockedExchange(&s_said, 1) == 0)
+            fprintf(stderr, "[host-wait] Wine: short timed waits %s (PORT_WINE_TIMERS=1 = waitable timers)\n",
+                    on ? "in process (NtDelayExecution / NtWaitForSingleObject)" : "on waitable timers");
+        v = on;
+    }
+    return v;
+}
+
+static inline void host_sleep_us(long long us)
+{
+    LARGE_INTEGER d; d.QuadPart = -(us * 10);
+    s_host_wait_delay(FALSE, &d);
+}
+
+/* WAIT_OBJECT_0 when h was signalled, WAIT_TIMEOUT otherwise (the NTSTATUS values match) */
+static inline DWORD host_wait_us(HANDLE h, long long us)
+{
+    LARGE_INTEGER d; d.QuadPart = -(us * 10);
+    return (DWORD)s_host_wait_single(h, FALSE, &d);
+}
+#endif
+#endif
