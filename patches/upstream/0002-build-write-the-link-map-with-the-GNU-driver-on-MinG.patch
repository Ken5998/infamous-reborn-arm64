 <46025606+Ken5998@users.noreply.github.com>
Date: Sat, 14 Nov 2026 20:17:54 +0000
Subject: [PATCH 2/5] build: write the link map with the GNU driver on MinGW

/MAP: is an MSVC linker option; the MinGW clang driver takes it for an
input file.
---
 infamous-recomp/CMakeLists.txt | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/infamous-recomp/CMakeLists.txt b/infamous-recomp/CMakeLists.txt
index 521dcc7..c80bd40 100644
--- a/infamous-recomp/CMakeLists.txt
+++ b/infamous-recomp/CMakeLists.txt
@@ -669,8 +669,10 @@ if(PORT_CPU_COMPAT)
         endif()
     endif()
 endif()
-if(WIN32)
+if(WIN32 AND MSVC)
     target_link_options(${PROJECT_NAME} PRIVATE "/MAP:${CMAKE_BINARY_DIR}/${_v242b_exe}.map")
+elseif(WIN32)   # MinGW (the Windows ARM64 build): same map through the GNU driver
+    target_link_options(${PROJECT_NAME} PRIVATE "-Wl,-Map=${CMAKE_BINARY_DIR}/${_v242b_exe}.map")
 endif()
 # v242B PORT_CPU_CHECK (default ON): entry point v242b_entry (main.cpp) checks the CPU features BEFORE the C runtime
 # and static constructors run (AVX2 code there would crash an older CPU first) and starts inFamousRecomp_sse4.exe or
